{
  "plugins": [
    {
      "id": "steer-action-arbitrum-node-1",
      "path": "steer-action-plugin/index.ts",
      "timeout": 120,
      "allow_get_invocation": false,
      "config": {
        "relayerId": "REPLACE_WITH_CONFIGURED_KEEPER_RELAYER_ID",
        "chainId": "42161",
        "maxGas": 1000000,
        "maxGasPrice": "REPLACE_WITH_OPERATOR_FEE_CAP_WEI",
        "marginBps": 1000,
        "maxSnapshotAgeSeconds": 60,
        "profile": {
          "id": "steer-orchestrator-v1-arbitrum",
          "backend": "guarded-rpc",
          "proxyCodeHash": "REPLACE_WITH_VERIFIED_PROXY_RUNTIME_HASH",
          "implementationCodeHash": "REPLACE_WITH_VERIFIED_IMPLEMENTATION_RUNTIME_HASH"
        },
        "estimateEnabled": false,
        "submitEnabled": false,
        "deadlineMs": 30000
      },
      "raw_response": false
    }
  ]
}
