{
  "name": "steer-action-plugin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:guard": "node scripts/build-guard.cjs",
    "check:guard": "node scripts/build-guard.cjs --check",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "validate:live": "tsx scripts/validate-live.ts",
    "validate": "npm run check:guard && npm run typecheck && npm run format:check && npm test",
    "format:check": "prettier --check \"*.ts\" \"*.json\" \"scripts/*.cjs\" \"scripts/*.ts\" \"tests/*.ts\" README.md"
  },
  "dependencies": {
    "@openzeppelin/relayer-sdk": "1.10.0",
    "ethers": "6.14.3"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "prettier": "3.6.2",
    "solc": "0.8.30",
    "tsx": "4.20.3",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
